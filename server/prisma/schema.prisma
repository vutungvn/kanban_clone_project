generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String
  passwordHash      String
  // Đã bấm link xác minh trong email (null = chưa xác minh)
  emailVerifiedAt   DateTime?
  avatarUrl         String?
  // Nơi lưu ảnh đại diện (storageKey, xem StorageService) — để xoá ảnh cũ khi đổi / gỡ
  avatarKey         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  emailTokens       EmailToken[]
  ownedBoards       Board[]
  memberships       BoardMember[]
  joinRequests      BoardJoinRequest[]
  cardMembers       CardMember[]
  activities        Activity[]
  // Thông báo mình nhận / thông báo do mình gây ra
  notifications     Notification[]     @relation("NotificationRecipient")
  sentNotifications Notification[]     @relation("NotificationActor")

  @@map("users")
}

// Mỗi lần đăng nhập = 1 session. Refresh token lưu dạng hash; đăng xuất = xoá session.
model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  // Lần cuối làm mới access token (~15 phút / lần khi đang dùng)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// Link gửi qua email (xác minh email, đặt lại mật khẩu). Chỉ lưu hash của token; dùng 1 lần, có hạn.
model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@map("email_tokens")
}

model Board {
  id                     String             @id @default(cuid())
  title                  String
  // Key phông nền dựng sẵn — xem BOARD_BACKGROUNDS trong src/boards/boards.constants.ts
  background             String
  ownerId                String
  // Liên kết mời: null = đang tắt. Tạo lại = token mới → link cũ hết hiệu lực.
  inviteToken            String?            @unique
  // Vai trò người vào qua link nhận được (chỉ MEMBER / VIEWER)
  inviteRole             BoardRole          @default(MEMBER)
  // true: mở link chỉ gửi được yêu cầu, ADMIN duyệt mới thành thành viên
  inviteRequiresApproval Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  owner                  User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members                BoardMember[]
  joinRequests           BoardJoinRequest[]
  lists                  List[]
  labels                 Label[]
  activities             Activity[]
  notifications          Notification[]

  @@index([ownerId])
  @@map("boards")
}

enum BoardRole {
  ADMIN
  MEMBER
  VIEWER
}

// User ↔ Board. Đánh dấu sao & lần xem gần nhất là của từng người nên nằm ở đây.
model BoardMember {
  boardId      String
  userId       String
  role         BoardRole @default(MEMBER)
  starred      Boolean   @default(false)
  lastViewedAt DateTime?
  joinedAt     DateTime  @default(now())
  board        Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  @@index([userId])
  @@map("board_members")
}

// Yêu cầu tham gia qua liên kết ở chế độ "cần duyệt". Duyệt → tạo BoardMember và xoá yêu cầu.
model BoardJoinRequest {
  boardId   String
  userId    String
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  @@index([userId])
  @@map("board_join_requests")
}

// position: số thực, sắp xếp tăng dần. Chèn giữa 2 phần tử = trung bình cộng → chỉ cập nhật 1 dòng.
model List {
  id         String    @id @default(cuid())
  boardId    String
  title      String
  position   Float
  // Đã lưu trữ: ẩn khỏi bảng cùng mọi thẻ bên trong; khôi phục thì về đúng vị trí cũ
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  board      Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards      Card[]

  @@index([boardId, position])
  @@map("lists")
}

model Card {
  id                String         @id @default(cuid())
  listId            String
  title             String
  description       String?
  position          Float
  // Ngày bắt đầu / hạn chót (đều tuỳ chọn). Nếu có cả hai thì startDate <= dueDate.
  startDate         DateTime?
  dueDate           DateTime?
  // Đánh dấu đã hoàn thành hạn chót — xoá hạn chót thì tự về false
  dueComplete       Boolean        @default(false)
  // Đã lưu trữ: ẩn khỏi bảng (vẫn mở được qua link); khôi phục thì về đúng vị trí cũ
  archivedAt        DateTime?
  // Ảnh bìa: 1 màu (key trong COVER_COLORS) HOẶC 1 ảnh đính kèm của chính thẻ — không có cả hai
  coverColor        String?
  coverAttachmentId String?        @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  list              List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  labels            CardLabel[]
  members           CardMember[]
  checklists        Checklist[]
  activities        Activity[]
  notifications     Notification[]
  attachments       Attachment[]   @relation("CardAttachments")
  // Xoá ảnh đang làm bìa → thẻ hết ảnh bìa
  coverAttachment   Attachment?    @relation("CardCover", fields: [coverAttachmentId], references: [id], onDelete: SetNull)

  @@index([listId, position])
  @@map("cards")
}

// Nhãn thuộc về bảng; thẻ gắn nhãn qua CardLabel. Tên có thể rỗng (nhãn chỉ có màu).
model Label {
  id        String      @id @default(cuid())
  boardId   String
  name      String      @default("")
  // Key màu dựng sẵn — xem LABEL_COLORS trong src/boards/boards.constants.ts
  color     String
  createdAt DateTime    @default(now())
  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     CardLabel[]

  @@index([boardId])
  @@map("labels")
}

model CardLabel {
  cardId  String
  labelId String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
  @@map("card_labels")
}

// Thành viên được giao thẻ — phải là thành viên của bảng; rời / bị xoá khỏi bảng thì bị gỡ khỏi mọi thẻ.
model CardMember {
  cardId    String
  userId    String
  createdAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
  @@map("card_members")
}

model Checklist {
  id        String          @id @default(cuid())
  cardId    String
  title     String
  position  Float
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  card      Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]

  @@index([cardId, position])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  title       String
  completed   Boolean   @default(false)
  position    Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId, position])
  @@map("checklist_items")
}

// Tệp đính kèm của thẻ, lưu trên Cloudinary (dev chưa cấu hình thì lưu ở ổ đĩa).
// Bản sao của thẻ dùng chung tệp (cùng storageKey) — chỉ xoá tệp thật khi không còn dòng nào trỏ tới.
model Attachment {
  id         String   @id @default(cuid())
  cardId     String
  // Tên tệp gốc (đổi được)
  name       String
  url        String
  // "image:<public_id>" / "raw:<public_id>" (Cloudinary) hoặc "local:<tên tệp>"
  storageKey String
  mimeType   String
  // Byte
  size       Int
  // Kích thước ảnh (null nếu không phải ảnh / không đọc được)
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())
  card       Card     @relation("CardAttachments", fields: [cardId], references: [id], onDelete: Cascade)
  coverOf    Card?    @relation("CardCover")

  @@index([cardId, createdAt])
  @@index([storageKey])
  @@map("attachments")
}

enum ActivityType {
  COMMENT
  CARD_CREATED
  CARD_RENAMED
  CARD_MOVED
  LABEL_ADDED
  LABEL_REMOVED
  MEMBER_ADDED
  MEMBER_REMOVED
  DATES_CHANGED
  DUE_COMPLETE_CHANGED
  CHECKLIST_ADDED
  CHECKLIST_REMOVED
  CHECKLIST_ITEM_COMPLETED
  CHECKLIST_ITEM_UNCOMPLETED
  CARD_ARCHIVED
  CARD_RESTORED
  CARD_COPIED
  CARD_TRANSFERRED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
}

// Lịch sử hoạt động của thẻ; bình luận cũng là 1 hoạt động (type COMMENT, nội dung ở `text`).
// `data` chụp lại tên nhãn / danh sách / thành viên... tại thời điểm đó — đổi tên hay xoá sau này không làm sai lịch sử.
model Activity {
  id        String       @id @default(cuid())
  boardId   String
  cardId    String
  // Người thực hiện; null nếu tài khoản đã bị xoá
  userId    String?
  type      ActivityType
  data      Json         @default("{}")
  text      String?
  // Lần sửa bình luận gần nhất
  editedAt  DateTime?
  createdAt DateTime     @default(now())
  board     Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card      Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([cardId, createdAt])
  @@index([boardId, createdAt])
  @@map("activities")
}

enum NotificationType {
  CARD_ASSIGNED
  CARD_UNASSIGNED
  CARD_COMMENT
  COMMENT_MENTION
  CARD_DUE_CHANGED
  CARD_MOVED
  BOARD_INVITED
  ROLE_CHANGED
  JOIN_REQUESTED
  JOIN_APPROVED
}

// Thông báo gửi tới 1 người. `data` chụp lại tên bảng / thẻ / trích đoạn bình luận... lúc tạo.
// Bảng / thẻ bị xoá → thông báo liên quan bị xoá theo.
model Notification {
  id        String           @id @default(cuid())
  // Người nhận
  userId    String
  // Người gây ra; null nếu tài khoản đã bị xoá
  actorId   String?
  boardId   String?
  cardId    String?
  type      NotificationType
  data      Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  board     Board?           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card      Card?            @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

PORT=4000
CLIENT_URL=http://localhost:3000

DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban?schema=public"

# Đổi thành chuỗi ngẫu nhiên dài khi deploy (vd: openssl rand -base64 48)
JWT_ACCESS_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# true khi chạy HTTPS; COOKIE_DOMAIN dùng khi client/api khác subdomain (vd: .example.com)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Swagger UI tại /api/docs; mặc định bật, tắt khi NODE_ENV=production
SWAGGER_ENABLED=true

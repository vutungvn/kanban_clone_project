PORT=4000
CLIENT_URL=http://localhost:3000

DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban?schema=public"

# Đổi thành chuỗi ngẫu nhiên dài khi deploy (vd: openssl rand -base64 48)
JWT_ACCESS_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# true khi chạy HTTPS; COOKIE_DOMAIN dùng khi client/api khác subdomain (vd: .example.com)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Swagger UI tại /api/docs; mặc định bật, tắt khi NODE_ENV=production
SWAGGER_ENABLED=true

# Lưu tệp đính kèm trên Cloudinary (Dashboard → Settings → API Keys). Để trống khi dev → lưu vào thư mục uploads/
# Production bắt buộc có (ổ đĩa của Render bị xoá mỗi lần deploy). Dev dùng thư mục kanban-dev, production dùng kanban.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gửi email (xác minh email, quên mật khẩu) qua SMTP. Để trống SMTP_HOST → không gửi mail, không bắt xác minh email.
# Ví dụ Gmail: bật xác minh 2 bước → tạo "Mật khẩu ứng dụng" tại https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Để trống → "Kanban <SMTP_USER>"
MAIL_FROM=

# Production trên Render: gói free CHẶN SMTP → gửi qua HTTP API của Brevo (có BREVO_API_KEY thì bỏ qua SMTP_*).
# Brevo → SMTP & API → API Keys → tạo key; Senders → thêm + xác minh email người gửi, rồi đặt MAIL_FROM="Kanban <email đó>"
BREVO_API_KEY=

# Nhắc hạn chót (thẻ còn dưới 24 giờ / vừa quá hạn): quét trong process mỗi N phút (0 = tắt, chỉ chạy qua endpoint).
# Render free cho server ngủ → GitHub Actions (.github/workflows/due-reminders.yml) gọi POST /api/internal/due-reminders/run
# kèm header x-cron-secret = CRON_SECRET. Để trống CRON_SECRET → endpoint luôn trả 401. Tạo: openssl rand -hex 32
DUE_REMINDER_INTERVAL_MINUTES=15
CRON_SECRET=
# Múi giờ hiển thị giờ hạn chót trong email (server chạy UTC)
APP_TIMEZONE=Asia/Ho_Chi_Minh
